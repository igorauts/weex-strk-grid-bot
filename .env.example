WEEX_API_KEY=
WEEX_SECRET_KEY=
WEEX_PASSPHRASE=

# VPS: resume an EXISTING bot without stdin.
# AUTO_RESUME never performs first START06 and never silently seeds a new grid.
AUTO_RESUME=1

# Signed/private REST limiter inside this process.
WEEX_PRIVATE_REST_MIN_GAP=0.20

# Alert after this many seconds of private-WS outage.
PRIVATE_WS_ALERT_AFTER=60

# Optional Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
